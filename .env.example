# ============================================================
# 🎵 HARMONY MUSIC — CONFIGURAÇÕES DE AMBIENTE (.env)
# ============================================================

# --- Servidor e Rede ---
HARMONY_HOST=0.0.0.0
HARMONY_PORT=5050
HARMONY_DEBUG=false

# --- Diretórios de Armazenamento ---
# Deixe em branco ou comente para usar as pastas padrão do projeto.
# HARMONY_DATA_DIR=/caminho/para/dados
# HARMONY_LIBRARY_DIR=/caminho/para/musicas

# --- Concorrência e Downloads ---
HARMONY_MAX_PARALLEL=3

# --- Credenciais da API do Spotify (OPCIONAL) ---
# O Harmony Music funciona 100% de fábrica SEM precisar de chaves de API,
# utilizando scrapers e endpoints oEmbed oficiais de alta velocidade.
#
# Caso você deseje utilizar seu próprio App no portal de desenvolvedores do Spotify,
# crie uma aplicação em https://developer.spotify.com/dashboard e preencha abaixo:
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

